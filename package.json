{
	"name": "remarkdown.css",
	"version": "4.0.0-beta.2",
	"license": "MIT",
	"description": "Remarkdown makes HTML look like plain Markdown text",
	"homepage": "https://fvsch.github.io/remarkdown/",
	"repository": {
		"type": "git",
		"url": "https://github.com/fvsch/remarkdown.git"
	},
	"author": "Florens Verschelde",
	"keywords": [
		"css",
		"sass",
		"markdown"
	],
	"files": [
		"README.md",
		"dist",
		"lib",
		"preset"
	],
	"type": "module",
	"exports": {
		".": {
			"sass": "./lib/rmd.scss",
			"style": "./dist/remarkdown.css",
			"browser": "./dist/remarkdown.css"
		}
	},
	"style": "./dist/remarkdown.css",
	"browser": "./dist/remarkdown.css",
	"scripts": {
		"build": "node build.ts",
		"format": "oxfmt --write '**/*.scss' '**/*.js'",
		"prepack": "pnpm run build",
		"start": "servitsy docs",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^24.13.5",
		"oxfmt": "^0.70.0",
		"postcss": "^8.5.28",
		"postcss-combine-duplicated-selectors": "^10.0.3",
		"sass": "^1.105.0",
		"servitsy": "^0.6.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
