{
	"name": "remarkdown.css",
	"version": "4.0.0-beta.2",
	"description": "Remarkdown makes HTML look like plain Markdown text",
	"homepage": "https://fvsch.github.io/remarkdown/",
	"license": "MIT",
	"author": "Florens Verschelde",
	"repository": {
		"type": "git",
		"url": "https://github.com/fvsch/remarkdown.git"
	},
	"keywords": [
		"css",
		"sass",
		"markdown"
	],
	"files": [
		"README.md",
		"dist",
		"preset",
		"rmd"
	],
	"type": "module",
	"exports": {
		".": {
			"style": "./dist/remarkdown.css",
			"sass": "./rmd/_index.scss"
		},
		"./rmd": {
			"sass": "./rmd/_index.scss"
		},
		"./rmd/config": {
			"sass": "./rmd/config/_index.scss"
		},
		"./rmd/styles": {
			"sass": "./rmd/styles/_index.scss"
		}
	},
	"browser": "./dist/remarkdown.css",
	"scripts": {
		"build": "node build.ts",
		"format": "oxfmt --write '**/*.scss' '**/*.{js,ts}'",
		"prepack": "pnpm run build",
		"start": "servitsy docs",
		"test": "vitest run"
	},
	"devDependencies": {
		"@types/node": "^24.13.5",
		"happy-dom": "^21.0.1",
		"oxfmt": "^0.73.0",
		"postcss": "^8.5.30",
		"postcss-combine-duplicated-selectors": "^11.0.0",
		"sass": "^1.105.1",
		"servitsy": "^0.6.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.4"
	}
}
